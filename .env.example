# Cloudflare Pages public variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_API_URL=https://your-api.onrender.com

# Render backend variables (do not put these in Pages)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_STORAGE_BUCKET=generated-documents
LLM_KEY_ENCRYPTION_SECRET=replace-with-at-least-32-random-bytes
ALLOWED_ORIGINS=https://your-pages-domain.pages.dev

# Optional runtime tuning
PYTHON_BIN=python3
LLM_REQUEST_TIMEOUT_MS=180000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AI_RATE_LIMIT_MAX=30
PORT=8787
