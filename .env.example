# Browser-visible variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Vercel server-side variables (never expose these to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_STORAGE_BUCKET=generated-documents
CONVERTER_SHARED_SECRET=replace-with-a-long-random-secret
LLM_REQUEST_TIMEOUT_MS=120000

# Local development only. Vercel uses api/convert.py in production.
PYTHON_BIN=python3
