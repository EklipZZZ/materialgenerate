# Browser-visible variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Vercel server-side variables (never expose these to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_STORAGE_BUCKET=generated-documents
CONVERTER_SHARED_SECRET=replace-with-a-long-random-secret
DOCX_PDF_CONVERTER_URL=https://your-converter.example.com
LLM_CONFIG_ENCRYPTION_KEY=base64-encoded-32-byte-key
LLM_REQUEST_TIMEOUT_MS=120000
# A queued/running job older than this is considered interrupted and can be reclaimed on retry.
GENERATION_JOB_STALE_MS=360000

# Local development only. Vercel uses api/convert.py for DOCX and the external service for PDF.
PYTHON_BIN=python3
LIBREOFFICE_BIN=/path/to/soffice
