{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "functions": {
    "api/convert.py": {
      "maxDuration": 60,
      "includeFiles": "assets/**/*"
    },
    "src/app/api/generate/route.ts": {
      "maxDuration": 600,
      "includeFiles": "node_modules/@fontsource/noto-sans-sc/files/noto-sans-sc-chinese-simplified-400-normal.woff"
    }
  }
}
